# ═══════════════════════════════════════════════════════════════
# POE Agentified STR System — Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
PYTHONPATH=/app
NODE_ENV=development

# ──────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ──────────────────────────────────────────────
POSTGRES_DB=poe_str
POSTGRES_USER=poe
POSTGRES_PASSWORD=poe_dev_password
DATABASE_URL=postgresql+asyncpg://poe:poe_dev_password@localhost:5432/poe_str

# ──────────────────────────────────────────────
# Message Bus (NATS JetStream)
# ──────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_JETSTREAM_DOMAIN=poe

# ──────────────────────────────────────────────
# Cache (Redis)
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# API & Frontend
# ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
FRONTEND_PORT=3000

# ──────────────────────────────────────────────
# Authentication & Security
# ──────────────────────────────────────────────
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ──────────────────────────────────────────────
# PMS Integration — OwnerRez
# ──────────────────────────────────────────────
OWNERREZ_API_URL=https://api.ownerrez.com
OWNERREZ_CLIENT_ID=your_ownerrez_client_id
OWNERREZ_CLIENT_SECRET=your_ownerrez_client_secret
OWNERREZ_REDIRECT_URI=http://localhost:3000/auth/ownerrez/callback
OWNERREZ_WEBHOOK_SECRET=your_webhook_secret
OWNERREZ_SANDBOX=true

# ──────────────────────────────────────────────
# PMS Integration — Hospitable
# ──────────────────────────────────────────────
HOSPITABLE_API_URL=https://api.hospitable.com
HOSPITABLE_CLIENT_ID=your_hospitable_client_id
HOSPITABLE_CLIENT_SECRET=your_hospitable_client_secret
HOSPITABLE_REDIRECT_URI=http://localhost:3000/auth/hospitable/callback
HOSPITABLE_WEBHOOK_SECRET=your_webhook_secret
HOSPITABLE_SANDBOX=true

# ──────────────────────────────────────────────
# Agent Runtime
# ──────────────────────────────────────────────
AGENT_MODE=development
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=poe-str-dev
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ──────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=poe-str
PROMETHEUS_PORT=9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ──────────────────────────────────────────────
# External Services (optional)
# ──────────────────────────────────────────────
SENTRY_DSN=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@poe-str.local